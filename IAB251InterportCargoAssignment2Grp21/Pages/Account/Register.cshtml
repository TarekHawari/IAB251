@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="card shadow-sm">
            <div class="card-body">

                <h2 class="card-title mb-3">Customer Registration</h2>

                <p class="text-muted">
                    New customers can register their details to access quotation request services.
                </p>

                <form method="post">

                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input class="form-control" asp-for="customer.FirstName" placeholder="Enter first name" />
                        <span class="text-danger" asp-validation-for="customer.FirstName"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Family Name</label>
                        <input class="form-control" asp-for="customer.FamilyName" placeholder="Enter family name" />
                        <span class="text-danger" asp-validation-for="customer.FamilyName"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input class="form-control" asp-for="customer.Email" placeholder="Enter email address" />
                        <span class="text-danger" asp-validation-for="customer.Email"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input class="form-control" asp-for="customer.Phone" type="tel" placeholder="Enter phone number" />
                        <span class="text-danger" asp-validation-for="customer.Phone"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Company Name</label>
                        <input class="form-control" asp-for="customer.CompanyName" placeholder="Enter company name if applicable" />
                        <span class="text-danger" asp-validation-for="customer.CompanyName"></span>
                    </div>

                    <div class="mb-3"> 
                        <label class="form-label">Address</label>
                        <input class="form-control" asp-for="customer.Address" placeholder="Enter address" />
                        <span class="text-danger" asp-validation-for="customer.Address"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" asp-for="customer.Password" type="password" placeholder="Enter password" />
                        <span class="text-danger" asp-validation-for="customer.Password"></span>
                    </div>

                    <button type="submit" class="btn btn-primary" asp-page-handler="CustomerRegister">
                        Register
                    </button>

                    <a asp-page="/Index" class="btn btn-secondary ms-2">
                        Cancel
                    </a>

                </form>

            </div>
        </div>

    </div>
</div>