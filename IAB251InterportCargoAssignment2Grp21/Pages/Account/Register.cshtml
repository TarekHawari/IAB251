@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="card shadow-sm">
            <div class="card-body">

                <h2 class="card-title mb-3">Customer Registration</h2>

                <p class="text-muted">
                    New customers can register their details to access quotation request services.
                </p>

                @* xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx charavter limit *@
                <form method="post">

                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input class="form-control" name="FirstName" nametype="text" placeholder="Enter first name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Family Name</label>
                        <input class="form-control" name="FamilyName" type="text" placeholder="Enter family name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input class="form-control" asp-for="customer.Email" placeholder="Enter email address" />
                        <span class="text-danger" asp-validation-for="customer.Email">  </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input class="form-control" name="Phone" type="tel" placeholder="Enter phone number" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Company Name</label>
                        <input class="form-control" name="CompanyName" type="text" placeholder="Enter company name if applicable" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input class="form-control" name="Address" type="text" placeholder="Enter address" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" name="Password" type="password" placeholder="Enter password" />
                    </div>

                    <button type="submit" class="btn btn-primary" asp-page-handler="CustomerRegister">
                        Register
                    </button>

                    <a asp-page="/Index" class="btn btn-secondary ms-2">
                        Cancel
                    </a>

                </form>

            </div>
        </div>

    </div>
</div>