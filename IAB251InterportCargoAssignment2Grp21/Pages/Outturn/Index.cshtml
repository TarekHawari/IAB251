@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Outturn.IndexModel

@{
    ViewData["Title"] = "Outturn";

    var employeeName = HttpContext.Session.GetString("EmployeeName");
    var employeeRole = HttpContext.Session.GetString("EmployeeRole");

    var customerName = HttpContext.Session.GetString("CustomerName");
    var customerEmail = HttpContext.Session.GetString("CustomerEmail");

    var isCustomerLoggedIn = !string.IsNullOrWhiteSpace(customerName)
        && !string.IsNullOrWhiteSpace(customerEmail);

    var isQuotationOfficer = !string.IsNullOrWhiteSpace(employeeRole)
        && employeeRole.Replace(" ", "").Trim().ToLowerInvariant() == "quotationofficer";

    var isLoggedIn = isQuotationOfficer || isCustomerLoggedIn;
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <div class="card shadow-sm">
            <div class="card-body">

                <h2 class="card-title">Outturn Processing</h2>

                
                @if (isCustomerLoggedIn)
                {

                    <p class="text-muted">
                        Welcome, @customerName. Outturn functions are recognised as part of the wider InterportCargo enterprise system.
                    </p>

                    <p>
                        Outturn functionality is outside the current developmental prototype scope and will be implemented in a later iteration.
                    </p>

                    <a asp-page="/Quotes/CustomerDashboard" class="btn btn-primary">
                        Return to Customer Dashboard
                    </a>
                }



                else if (isQuotationOfficer)
                {

                    <p class="text-muted">
                        Welcome, @employeeName. Outturn functions are recognised as part of the wider InterportCargo enterprise system.
                    </p>

                    <p>
                        Outturn functionality is outside the current developmental prototype scope and will be implemented in a later iteration.
                    </p>

                    <a asp-page="/Quotes/OfficerDashboard" class="btn btn-primary">
                        Return to Quotation Dashboard
                    </a>
                }

                else
                {

                    <p class="text-muted">
                        Outturn processing functions are available to authorised users of the InterportCargo system.
                    </p>

                    <p>
                        Please log in to access outturn-related system functions.
                    </p>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-page="/Account/Login" class="btn btn-primary">
                            Login
                        </a>

                        <a asp-page="/Account/Register" class="btn btn-outline-dark">
                            Register
                        </a>

                        <a asp-page="/Index" class="btn btn-secondary">
                            Back to Home
                        </a>

                    </div>
                }
            </div>
        </div>

    </div>
</div>