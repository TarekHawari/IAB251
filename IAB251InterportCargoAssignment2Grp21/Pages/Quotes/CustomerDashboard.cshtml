@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Quotes.CustomerDashboardModel

@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2>Customer Dashboard</h2>

        <p class="text-muted">
            You are logged in as @Model.CustomerName.
        </p>

        <a asp-page="/Quotes/RequestQuotation" class="btn btn-primary">
            Submit Quotation Request
        </a>
    </div>
</div>

@if (Model.Notifications.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4>Notifications</h4>

            @foreach (var notification in Model.Notifications)
            {
                <div class="alert @(notification.IsRead ? "alert-secondary" : "alert-warning")">
                    <strong>@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong><br />
                    @notification.Message
                </div>
            }
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h4>Your Quotation Requests</h4>

        @if (Model.QuotationRequests.Any())
        {
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Request ID</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Containers</th>
                        <th>Status</th>
                        <th>Submitted</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.QuotationRequests)
                    {
                        <tr>
                            <td>@request.RequestId</td>
                            <td>@request.Source</td>
                            <td>@request.Destination</td>
                            <td>@request.NumberOfContainers</td>
                            <td>@request.Status</td>
                            <td>@request.SubmittedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">You have not submitted any quotation requests yet.</p>
        }
    </div>
</div>


<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h4>Your Quotations</h4>

        @if (Model.Quotations.Any())
        {
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Quotation Number</th>
                        <th>Date Issued</th>
                        <th>Container Type</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quotation in Model.Quotations)
                    {
                        <tr>
                            <td>@quotation.QuotationNumber</td>
                            <td>@quotation.DateIssued.ToString("dd/MM/yyyy")</td>
                            <td>@quotation.ContainerType</td>
                            <td>@quotation.TotalAmount.ToString("C")</td>
                            <td>@quotation.Status</td>
                            <td>
                                <a asp-page="/Quotes/ViewQuotation"
                                   asp-route-quotationId="@quotation.QuotationId"
                                   class="btn btn-sm btn-primary">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No quotations have been sent to you yet.</p>
        }
    </div>
</div>
