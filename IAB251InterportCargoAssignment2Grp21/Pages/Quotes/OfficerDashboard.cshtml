@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Quotes.OfficerDashboardModel
@{
    ViewData["Title"] = "Quotation Officer Dashboard";
}


<div class="card shadow-sm">
    <div class="card-body">
        <h2>Quotation Officer Dashboard</h2>

        <p class="text-muted">
            You are logged in as @Model.EmployeeName.
