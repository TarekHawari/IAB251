@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Quotes.OfficerDashboardModel

@{
    ViewData["Title"] = "Quotation Officer Dashboard";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2>Quotation Officer Dashboard</h2>

        <p class="text-muted">
            You are logged in as @Model.EmployeeName.
        </p>

        <div class="alert alert-info">
            Pending quotation requests: <strong>@Model.PendingRequests.Count</strong>
        </div>

        <a asp-page="/Quotes/OfficerQuotes" class="btn btn-primary">
            Open Quotation Management
        </a>
    </div>
</div>