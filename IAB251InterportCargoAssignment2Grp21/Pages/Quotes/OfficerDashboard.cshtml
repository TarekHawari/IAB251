@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Quotes.OfficerDashboardModel

@{
    ViewData["Title"] = "Quotation Officer Dashboard";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2>Quotation Officer Dashboard</h2>

        <p class="text-muted">
            You are logged in as @Model.EmployeeName.
        </p>

        <div class="alert alert-info">
            Pending quotation requests: <strong>@Model.PendingRequests.Count</strong>
        </div>

        <a asp-page="/Quotes/OfficerQuotes" class="btn btn-primary">
            Open Quotation Management
        </a>
    </div>
</div>

@if (Model.OfficerNotifications.Any())
{
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h4>Officer Notifications</h4>

            @foreach (var notification in Model.OfficerNotifications)
            {
                <div class="alert @(notification.IsRead ? "alert-secondary" : "alert-info")">
                    <strong>@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong><br />
                    @notification.Message
                </div>
            }
        </div>
    </div>
}