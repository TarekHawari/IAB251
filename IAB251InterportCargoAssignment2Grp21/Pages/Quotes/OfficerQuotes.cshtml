@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Quotes.OfficerQuotesModel

@{
    ViewData["Title"] = "Quotation Management";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2>Quotation Requests</h2>

        @if (Model.Requests.Any())
        {
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Request ID</th>
                        <th>Customer</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Containers</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.Requests)
                    {
                        <tr>
                            <td>@request.RequestId</td>
                            <td>@request.CustomerName</td>
                            <td>@request.Source</td>
                            <td>@request.Destination</td>
                            <td>@request.NumberOfContainers</td>
                            <td>

                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else if (request.Status == "QuotationPrepared")
                                {
                                    <span class="badge bg-success">Accepted</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@request.Status</span>
                                }

                            </td>
                            <td>@request.SubmittedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (request.Status == "Pending")
                                {
                                    <a asp-page="/Quotes/ReviewRequest"
                                       asp-route-requestId="@request.RequestId"
                                       class="btn btn-sm btn-primary">
                                        Review
                                    </a>
                                }
                                else
                                {
                                    <a asp-page="/Quotes/ReviewRequest"
                                       asp-route-requestId="@request.RequestId"
                                       class="btn btn-sm btn-secondary">
                                        Reviewed
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No quotation requests have been submitted yet.</p>
        }

        <hr class="my-4" />

        <h3>Prepared Quotations</h3>

        @if (Model.Quotations.Any())
        {
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Quotation Number</th>
                        <th>Client Name</th>
                        <th>Date Issued</th>
                        <th>Container Type</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quotation in Model.Quotations)
                    {
                        <tr>
                            <td>@quotation.QuotationNumber</td>
                            <td>@quotation.CustomerName</td>
                            <td>@quotation.DateIssued.ToString("dd/MM/yyyy")</td>
                            <td>@quotation.ContainerType</td>
                            <td>@quotation.TotalAmount.ToString("C")</td>
                            <td>@quotation.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No quotations have been prepared yet.</p>
        }

    </div>
</div>