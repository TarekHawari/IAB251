@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Quotes.OfficerQuotesModel

@{
    ViewData["Title"] = "Quotation Management";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2>Quotation Management</h2>

        @if (Model.Requests.Any())
        {
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Request ID</th>
                        <th>Customer</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Containers</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.Requests)
                    {
                        <tr>
                            <td>@request.RequestId</td>
                            <td>@request.CustomerName</td>
                            <td>@request.Source</td>
                            <td>@request.Destination</td>
                            <td>@request.NumberOfContainers</td>
                            <td>@request.Status</td>
                            <td>@request.SubmittedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-page="/Quotes/ReviewRequest"
                                   asp-route-requestId="@request.RequestId"
                                   class="btn btn-sm btn-primary">
                                    Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No quotation requests have been submitted yet.</p>
        }
    </div>
</div>