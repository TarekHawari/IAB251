@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Quotes.RequestQuotationModel

@{
    ViewData["Title"] = "Request Quotation";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2>Submit Quotation Request</h2>

                <p class="text-muted">
                    Provide the required freight details so InterportCargo can prepare an accurate quotation.
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }

                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Request.Source" class="form-label">
                            Source / Country of Origin
                        </label>
                        <input asp-for="Request.Source"
                               class="form-control"
                               placeholder="e.g. Australia, China, United States" />
                        <div class="form-text">
                            Enter the country or location where the goods are being shipped from.
                        </div>
                        <span asp-validation-for="Request.Source" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Request.Destination" class="form-label">
                            Destination
                        </label>
                        <input asp-for="Request.Destination"
                               class="form-control"
                               placeholder="e.g. Brisbane, Sydney, Singapore" />
                        <div class="form-text">
                            Enter the final delivery destination for the freight.
                        </div>
                        <span asp-validation-for="Request.Destination" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Request.NumberOfContainers" class="form-label"></label>
                        <input asp-for="Request.NumberOfContainers" class="form-control" />
                        <span asp-validation-for="Request.NumberOfContainers" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Request.GoodsType" class="form-label">Goods Type</label>
                        <input asp-for="Request.GoodsType" class="form-control" placeholder="e.g. electronics, textiles, machinery" />
                        <span asp-validation-for="Request.GoodsType" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Request.PackageWidth" class="form-label">
                                Package Width (mm)
                            </label>
                            <input asp-for="Request.PackageWidth"
                                   class="form-control"
                                   type="number"
                                   step="1"
                                   min="1"
                                   placeholder="e.g. 1200" />
                            <div class="form-text">
                                Enter the package width in millimetres.
                            </div>
                            <span asp-validation-for="Request.PackageWidth" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Request.PackageHeight" class="form-label">
                                Package Height (mm)
                            </label>
                            <input asp-for="Request.PackageHeight"
                                   class="form-control"
                                   type="number"
                                   step="1"
                                   min="1"
                                   placeholder="e.g. 800" />
                            <div class="form-text">
                                Enter the package height in millimetres.
                            </div>
                            <span asp-validation-for="Request.PackageHeight" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Request.ImportExportType" class="form-label">Import / Export</label>
                        <select asp-for="Request.ImportExportType" class="form-select">
                            <option value="">Select type</option>
                            <option value="Import">Import</option>
                            <option value="Export">Export</option>
                        </select>
                        <span asp-validation-for="Request.ImportExportType" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Request.PackingType" class="form-label">Packing / Unpacking</label>
                        <select asp-for="Request.PackingType" class="form-select">
                            <option value="">Select type</option>
                            <option value="Packing">Packing</option>
                            <option value="Unpacking">Unpacking</option>
                        </select>
                        <span asp-validation-for="Request.PackingType" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Request.RequiresQuarantine" class="form-check-input" id="requiresQuarantine" />
                        <label asp-for="Request.RequiresQuarantine" class="form-check-label">
                            Quarantine requirements apply
                        </label>
                    </div>

                    <div class="mb-3" id="quarantineDetailsGroup" style="display:none;">
                        <label asp-for="Request.QuarantineDetails" class="form-label">
                            Quarantine Details
                        </label>
                        <textarea asp-for="Request.QuarantineDetails"
                                  class="form-control"
                                  placeholder="Include origin and treatment history"></textarea>
                        <span asp-validation-for="Request.QuarantineDetails" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-2">
                        <input asp-for="Request.RequiresFumigation" class="form-check-input" id="requiresFumigation" />
                        <label asp-for="Request.RequiresFumigation" class="form-check-label">
                            Fumigation requirements apply
                        </label>
                    </div>

                    <div class="mb-3" id="fumigationDetailsGroup" style="display:none;">
                        <label asp-for="Request.FumigationDetails" class="form-label">
                            Fumigation Details
                        </label>
                        <textarea asp-for="Request.FumigationDetails"
                                  class="form-control"
                                  placeholder="Include potential pest threats or fumigation concerns"></textarea>
                        <span asp-validation-for="Request.FumigationDetails" class="text-danger"></span>
                    </div>



                    <button type="submit" class="btn btn-primary">Submit Request</button>
                    <a asp-page="/Quotes/CustomerDashboard" class="btn btn-secondary ms-2">Back to Dashboard</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const quarantineCheckbox = document.getElementById("requiresQuarantine");
            const quarantineGroup = document.getElementById("quarantineDetailsGroup");

            const fumigationCheckbox = document.getElementById("requiresFumigation");
            const fumigationGroup = document.getElementById("fumigationDetailsGroup");

            function toggleConditionalDetails() {
                if (quarantineCheckbox && quarantineGroup) {
                    quarantineGroup.style.display = quarantineCheckbox.checked ? "block" : "none";
                }

                if (fumigationCheckbox && fumigationGroup) {
                    fumigationGroup.style.display = fumigationCheckbox.checked ? "block" : "none";
                }
            }

            if (quarantineCheckbox) {
                quarantineCheckbox.addEventListener("change", toggleConditionalDetails);
            }

            if (fumigationCheckbox) {
                fumigationCheckbox.addEventListener("change", toggleConditionalDetails);
            }

            toggleConditionalDetails();
        });
    </script>
}
