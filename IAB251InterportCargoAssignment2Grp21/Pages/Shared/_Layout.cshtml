@{
    var employeeName = Context.Session.GetString("EmployeeName");
    var employeeRole = Context.Session.GetString("EmployeeRole");
    var isLoggedIn = !string.IsNullOrWhiteSpace(employeeName);
    var isQuotationOfficer = !string.IsNullOrWhiteSpace(employeeRole)
        && employeeRole.Replace(" ", "").Trim().ToLowerInvariant() == "quotationofficer";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - InterportCargo</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>

<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <!-- Brand / Home Link -->
            <a class="navbar-brand fw-bold" asp-page="/Index">
                InterportCargo
            </a>

            <!-- Mobile Navbar Toggle -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Content -->
            <div class="collapse navbar-collapse" id="navbarNav">

                <!-- Left-side Navigation -->
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            Home
                        </a>
                    </li>


                    @if (isQuotationOfficer)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Quotes/OfficerDashboard">
                                Quotation Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Quotes/OfficerQuotes">
                                View Quotes
                            </a>
                        </li>
                    }

                    else 
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Quotes/Index">
                                Quotes
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Bookings/Index">
                            Booking
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Outturn/Index">
                            Outturn
                        </a>
                    </li>

                </ul>

                <!-- Right-side Auth Buttons -->
                <div class="d-flex align-items-center gap-2">
                    @if (isLoggedIn)
                    {
                        <span class="navbar-text text-light me-2">
                            @employeeName
                        </span>

                        <a class="btn btn-outline-light" asp-page="/Account/Logout">
                            Logout
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-outline-light" asp-page="/Account/Register">
                            Sign Up
                        </a>

                        <a class="btn btn-primary" asp-page="/Account/Login">
                            Login
                        </a>
                    }
                </div>

            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>