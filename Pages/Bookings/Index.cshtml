@page
@model IAB251InterportCargoAssignment2Grp21.Pages.Bookings.IndexModel

@{
    ViewData["Title"] = "Booking";
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <div class="card shadow-sm">
            <div class="card-body">

                <h2 class="card-title">Booking Management</h2>

                <p class="text-muted">
                    Booking functions are available to registered InterportCargo customers and authorised employees.
                </p>

                <p>
                    Please log in to access booking-related system functions.
                </p>

                <div class="d-flex gap-2 mt-3">
                    <a asp-page="/Account/Login" class="btn btn-primary">
                        Login
                    </a>

                    <a asp-page="/Account/Register" class="btn btn-outline-dark">
                        Register
                    </a>

                    <a asp-page="/Index" class="btn btn-secondary">
                        Back to Home
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>